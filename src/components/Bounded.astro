---
import { cn } from "@lib/cn.ts";
import type { HTMLAttributes, HTMLTag } from "astro/types";

type Props<T extends HTMLTag = "div"> = HTMLAttributes<T> & {
    as?: T;
    yPadding?: "sm" | "base" | "lg";
};

// Props
const { as, yPadding = "base", class: className, ...rest } = Astro.props;

// Select wrapper element dynamically
const Tag: HTMLTag = as || "div";
---

<Tag
    {...rest}
    class={cn(
        "px-6 md:px-12 lg:px-16 xl:px-20",
        yPadding === "sm" && "py-8 md:py-10",
        yPadding === "base" && "py-20 md:py-28",
        yPadding === "lg" && "py-32 md:py-48",
        className,
    )}
>
    <div class="mx-auto w-full max-w-7xl">
        <slot />
    </div>
</Tag>
