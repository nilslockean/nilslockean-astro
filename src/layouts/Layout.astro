        <link rel="sitemap" href="/sitemap-index.xml" />
        <title>Nils Lockean - Web Developer</title>
    </head>
    <body class="font-sans text-base leading-normal bg-primary text-primary">
        <Header />
        <main class="">
            <slot />
        </main>
        <Footer />
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>
